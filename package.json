{
  "name": "frame-video-editor",
  "version": "1.0.0",
  "private": true,
  "description": "A local video editing studio with FFmpeg-powered MP4 exports",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/editor.test.js tests/catalog.test.js",
    "test:browser": "node tests/browser-check.js",
    "test:transition": "node tests/transition-browser-check.js",
    "test:music": "node tests/music-browser-check.js",
